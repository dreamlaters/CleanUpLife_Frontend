.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(248, 242, 233, 0.96);
  border-bottom: 1rpx solid rgba(216, 195, 170, 0.5);
}

.navbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 92rpx;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.navbar-content-home {
  height: 112rpx;
}

.navbar-copy {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
}

.brand-kicker {
  color: #a66b56;
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.navbar-title {
  color: #3f352f;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.greeting {
  color: #3f352f;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.date-text {
  font-size: 22rpx;
  color: #8a7b6f;
  font-weight: 400;
}

.brand-mark {
  position: relative;
  width: 62rpx;
  height: 62rpx;
  border: 1rpx solid #d8c3aa;
  border-radius: 20rpx 20rpx 20rpx 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9f4f3d;
  background: #fffaf2;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 4rpx 12rpx rgba(91, 71, 55, 0.06);
}

.brand-mark-leaf {
  position: absolute;
  top: -8rpx;
  right: 4rpx;
  width: 20rpx;
  height: 12rpx;
  background: #91a887;
  border-radius: 100% 0 100% 0;
  transform: rotate(-18deg);
}

.reminder-mark {
  border-radius: 20rpx;
}

.reminder-dot {
  position: absolute;
  top: 7rpx;
  right: 7rpx;
  width: 12rpx;
  height: 12rpx;
  border: 3rpx solid #fffaf2;
  border-radius: 50%;
  background: #c96f55;
}

.navbar-placeholder {
  width: 100%;
  flex-shrink: 0;
}
