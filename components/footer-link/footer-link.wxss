.footer-link-wrap {
  padding: 18rpx 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.footer-link {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  padding: 0 24rpx;
  background: #f2e8db;
  border: 1rpx solid #e3d3c1;
  border-radius: 18rpx;
  transition: all 0.2s ease;
  width: 100%;
  box-sizing: border-box;
}

.footer-link:active {
  transform: scale(0.98);
  background: #ede0d0;
}

.footer-link-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: #fffaf2;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.footer-link-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.footer-link-text {
  font-size: 28rpx;
  color: #3f352f;
  font-weight: 600;
}

.footer-link-hint {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #8a7b6f;
}
