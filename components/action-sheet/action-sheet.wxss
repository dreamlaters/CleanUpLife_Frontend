.action-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(63, 53, 47, 0.42);
  z-index: 200;
  display: flex;
  align-items: flex-end;
  opacity: 0;
  visibility: hidden;
  transition: all 0.25s ease;
}

.action-overlay.show {
  opacity: 1;
  visibility: visible;
}

.action-sheet {
  width: 100%;
  background: #fffdf8;
  border-radius: 30rpx 30rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.action-overlay.show .action-sheet {
  transform: translateY(0);
}

.action-header {
  padding: 24rpx;
  text-align: center;
  border-bottom: 1rpx dashed #e6d8c8;
}

.action-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #3f352f;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 96rpx;
  padding: 0 34rpx;
  font-size: 30rpx;
  color: #3f352f;
  transition: background 0.15s ease;
}

.action-item:active {
  background: #faf3e9;
}

.action-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: #f4e7d5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-text {
  font-weight: 500;
}

.action-danger {
  color: #b85c52;
}

.action-icon-danger {
  background: #f6e1dd;
}

.action-cancel {
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  color: #6a5c50;
  background: #f2e8db;
  margin-top: 8rpx;
}
