<view class="container">
  <custom-navbar greeting="{{greeting}}" dateText="{{dateText}}" showReminder="{{true}}" showReminderDot="{{reminderPending}}" statusBarHeight="{{statusBarHeight}}" navbarHeight="{{navbarHeight}}" />

  <view class="journal-hero">
    <view class="hero-copy">
      <text class="hero-eyebrow">猪猪 · 毛驴 · 豌豆黄 · 小立夏</text>
      <text class="hero-title">把琐碎日常，收进一本小手账</text>
      <text class="hero-note">今天也一起把生活照顾好。</text>
    </view>
    <image class="hero-illustration" src="/images/illustrations/home-journal.svg" mode="aspectFit" />
  </view>

  <loading-state loading="{{loading}}" />

  <view class="dashboard-refresh" wx:if="{{refreshing}}">
    <text>正在更新首页，已加载内容仍可查看…</text>
  </view>
  <view class="dashboard-error" wx:if="{{!loading && failedSections.length}}">
    <view class="section-error-copy">
      <text class="section-error-title">{{dashboardError || (failedSections.length === 7 ? '首页各模块暂时无法加载' : '部分内容暂时无法加载')}}</text>
      <text class="section-error-message">未加载不代表没有记录，可单独重试；其余内容仍可查看。</text>
    </view>
    <button class="section-retry" size="mini" bindtap="retryFailedSections" disabled="{{refreshing}}">重试失败项</button>
  </view>

  <view class="today-section" wx:if="{{!loading}}">
    <view class="section-heading">
      <view class="section-heading-copy">
        <text class="section-kicker">TODAY</text>
        <view class="section-title-row">
          <text class="section-title">今天要留意</text>
          <text class="section-count" wx:if="{{attentionCount}}">{{attentionComplete ? '' : '已知 '}}{{attentionCount}} 件</text>
        </view>
      </view>
    </view>

    <view class="attention-incomplete" wx:if="{{!attentionComplete}}">
      <text class="section-error-title">提醒尚未确认完整</text>
      <text class="section-error-message">{{attentionPendingNames}}尚未确认，提醒数量可能不完整。</text>
    </view>
    <view class="section-error" wx:if="{{sectionStates.products.status === 'error'}}">
      <view class="section-error-copy">
        <text class="section-error-title">物品到期提醒暂不可用</text>
        <text class="section-error-message">{{sectionStates.products.loading ? '正在重试…' : sectionStates.products.error}}</text>
      </view>
      <button class="section-retry" size="mini" data-section="products" bindtap="retryFailedSections" disabled="{{refreshing}}">重试</button>
    </view>
    <view class="section-error" wx:if="{{sectionStates.play.status === 'error'}}">
      <view class="section-error-copy">
        <text class="section-error-title">猫猫陪玩状态暂不可用</text>
        <text class="section-error-message">{{sectionStates.play.loading ? '正在重试…' : sectionStates.play.error}}</text>
      </view>
      <button class="section-retry" size="mini" data-section="play" bindtap="retryFailedSections" disabled="{{refreshing}}">重试</button>
    </view>

    <view class="attention-card" wx:if="{{attentionCount}}">
      <view
        class="attention-item attention-danger"
        wx:for="{{expiredItems}}"
        wx:key="id"
        bindtap="goToUpdateItem"
        data-id="{{item.id}}"
        data-category="{{item.category}}"
      >
        <view class="attention-icon"><app-icon name="alert" size="34" /></view>
        <view class="attention-copy">
          <text class="attention-name">{{item.name}}</text>
          <text class="attention-meta">已经过期 {{item.daysText}}</text>
        </view>
        <text class="attention-status">需处理</text>
        <app-icon name="chevron-right" size="28" />
      </view>

      <view class="attention-item attention-live" bindtap="goToPlay" wx:if="{{playStatus && playStatus.ongoing}}">
        <view class="attention-icon"><app-icon name="timer" size="34" /></view>
        <view class="attention-copy">
          <text class="attention-name">猫猫陪玩正在进行</text>
          <text class="attention-meta">返回猫猫页继续计时或结束记录</text>
        </view>
        <text class="attention-status">进行中</text>
        <app-icon name="chevron-right" size="28" />
      </view>

      <view class="attention-item attention-savings" bindtap="goToSavings" wx:if="{{savingsSummary && savingsSummary.hasSetup && savingsSummary.isProvisional}}">
        <view class="attention-icon"><app-icon name="piggy-bank" size="34" /></view>
        <view class="attention-copy">
          <text class="attention-name">本月退休存钱还未合账</text>
          <text class="attention-meta">{{savingsSummary.checkInText}}</text>
        </view>
        <text class="attention-status">去盘点</text>
        <app-icon name="chevron-right" size="28" />
      </view>

      <view
        class="attention-item attention-warning"
        wx:for="{{expiringSoonItems}}"
        wx:key="id"
        bindtap="goToUpdateItem"
        data-id="{{item.id}}"
        data-category="{{item.category}}"
      >
        <view class="attention-icon"><app-icon name="calendar" size="34" /></view>
        <view class="attention-copy">
          <text class="attention-name">{{item.name}}</text>
          <text class="attention-meta">{{item.daysText}}后过期</text>
        </view>
        <text class="attention-status">快到期</text>
        <app-icon name="chevron-right" size="28" />
      </view>
    </view>

    <view class="all-clear-card" wx:if="{{allClear}}">
      <view class="all-clear-icon"><app-icon name="check" size="38" /></view>
      <view class="all-clear-copy">
        <text class="all-clear-title">今天没有待处理提醒</text>
        <text class="all-clear-text">物品状态都很安心，继续享受生活吧。</text>
      </view>
    </view>
  </view>

  <view class="quick-grid" wx:if="{{!loading}}">
    <view class="quick-item" bindtap="goToPlay">
      <view class="quick-icon quick-icon-cat"><app-icon name="cat" size="34" /></view>
      <text class="quick-action-title">陪猫玩</text>
      <text class="quick-label">{{sectionStates.play.status === 'ok' ? '开始计时' : '陪玩状态未加载'}}</text>
    </view>
    <view class="quick-item" bindtap="goToSavings">
      <view class="quick-icon quick-icon-savings"><app-icon name="piggy-bank" size="34" /></view>
      <text class="quick-action-title">更新存钱</text>
      <text class="quick-label">本月盘点</text>
    </view>
    <view class="quick-item" bindtap="goToAddToBuy">
      <view class="quick-icon quick-icon-cart"><app-icon name="cart" size="34" /></view>
      <text class="quick-action-title">添加待买</text>
      <text class="quick-label" wx:if="{{sectionStates.toBuy.status === 'ok'}}">{{toBuyCount}} 件待完成</text>
      <text class="quick-label section-unavailable" wx:else>待买数量未加载</text>
      <button class="section-retry quick-retry" size="mini" wx:if="{{sectionStates.toBuy.status === 'error'}}" data-section="toBuy" catchtap="retryFailedSections" disabled="{{refreshing}}">重试</button>
    </view>
  </view>

  <view class="life-section" wx:if="{{!loading}}">
    <view class="section-heading">
      <view>
        <text class="section-kicker">LIFE NOTES</text>
        <text class="section-title">最近的生活</text>
      </view>
    </view>

    <view class="savings-note" bindtap="goToSavings" wx:if="{{sectionStates.savings.status === 'ok'}}">
      <view class="savings-note-header">
        <view class="savings-title-wrap">
          <view class="life-card-icon savings-icon"><app-icon name="piggy-bank" size="40" /></view>
          <view>
            <text class="life-card-label">退休存钱罐</text>
            <text class="life-card-title">{{savingsSummary.netAssetsText}} 净资产</text>
          </view>
        </view>
        <app-icon name="chevron-right" size="30" />
      </view>
      <view class="savings-progress-copy">
        <text wx:if="{{savingsSummary.targetAmount > 0}}">目标 {{savingsSummary.targetText}} · {{savingsSummary.progress}}%</text>
        <text wx:else>先一起定下退休目标</text>
        <text class="savings-remaining" wx:if="{{savingsSummary.targetAmount > 0}}">还差 {{savingsSummary.remainingText}}</text>
      </view>
      <view class="savings-progress-track" wx:if="{{savingsSummary.targetAmount > 0}}">
        <view class="savings-progress-fill" style="width: {{savingsSummary.progressWidth}}%"></view>
      </view>
      <view class="savings-checkin {{savingsSummary.isProvisional ? 'savings-checkin-pending' : ''}}">
        <view class="savings-checkin-dot"></view>
        <text>{{savingsSummary.checkInText}}</text>
      </view>
    </view>
    <view class="section-error life-error" wx:elif="{{sectionStates.savings.status === 'error'}}">
      <view class="section-error-copy">
        <text class="section-error-title">退休存钱罐暂不可用</text>
        <text class="section-error-message">{{sectionStates.savings.loading ? '正在重试…' : sectionStates.savings.error}}</text>
      </view>
      <button class="section-retry" size="mini" data-section="savings" bindtap="retryFailedSections" disabled="{{refreshing}}">重试</button>
    </view>

    <view class="life-card period-card" bindtap="goToPeriod" wx:if="{{sectionStates.period.status === 'ok'}}">
      <view class="life-card-icon period-icon"><app-icon name="flower" size="38" /></view>
      <view class="life-card-copy">
        <text class="life-card-label">周期记录</text>
        <text class="life-card-title" wx:if="{{periodStats.status === 'none'}}">还没有开始记录</text>
        <text class="life-card-title" wx:elif="{{periodStats.status === 'in-period'}}">经期中，记得照顾好自己</text>
        <text class="life-card-title" wx:elif="{{periodStats.daysUntilNextPeriod === null}}">暂无预测日期</text>
        <text class="life-card-title" wx:elif="{{periodStats.daysUntilNextPeriod > 0}}">距下次预计还有 {{periodStats.daysUntilNextPeriod}} 天</text>
        <text class="life-card-title" wx:elif="{{periodStats.daysUntilNextPeriod === 0}}">预计今天开始</text>
        <text class="life-card-title" wx:else>已超出预计 {{-periodStats.daysUntilNextPeriod}} 天</text>
        <text class="life-card-meta" wx:if="{{periodStats.averageCycleDays}}">平均周期 {{periodStats.averageCycleDays}} 天</text>
      </view>
      <app-icon name="chevron-right" size="30" />
    </view>
    <view class="section-error life-error" wx:elif="{{sectionStates.period.status === 'error'}}">
      <view class="section-error-copy">
        <text class="section-error-title">周期记录暂不可用</text>
        <text class="section-error-message">{{sectionStates.period.loading ? '正在重试…' : sectionStates.period.error}}</text>
      </view>
      <button class="section-retry" size="mini" data-section="period" bindtap="retryFailedSections" disabled="{{refreshing}}">重试</button>
    </view>

    <view class="life-card cat-card" bindtap="goToWeight" wx:if="{{sectionStates.weights.status === 'ok'}}">
      <view class="life-card-icon cat-icon"><app-icon name="cat" size="40" /></view>
      <view class="life-card-copy">
        <text class="life-card-label">猫猫体重</text>
        <view class="cat-summary" wx:if="{{catWeights.length}}">
          <view class="cat-summary-item" wx:for="{{catWeights}}" wx:key="personName">
            <text class="cat-name">{{item.personName}}</text>
            <text class="cat-weight">{{item.weight}} 斤</text>
            <text class="cat-date">{{item.dateText}}</text>
          </view>
        </view>
        <text class="life-card-title" wx:else>还没有记录猫猫体重</text>
      </view>
      <app-icon name="chevron-right" size="30" />
    </view>
    <view class="section-error life-error" wx:elif="{{sectionStates.weights.status === 'error'}}">
      <view class="section-error-copy">
        <text class="section-error-title">猫猫体重暂不可用</text>
        <text class="section-error-message">{{sectionStates.weights.loading ? '正在重试…' : sectionStates.weights.error}}</text>
      </view>
      <button class="section-retry" size="mini" data-section="weights" bindtap="retryFailedSections" disabled="{{refreshing}}">重试</button>
    </view>

    <view class="goals-note" bindtap="goToGoals" wx:if="{{sectionStates.goals.status === 'ok'}}">
      <view class="goals-note-header">
        <view class="goals-note-title">
          <view class="life-card-icon goal-icon"><app-icon name="target" size="38" /></view>
          <view>
            <text class="life-card-label">年度目标</text>
            <text class="life-card-title">{{pigTotal || donkeyTotal ? '一起靠近想要的生活' : '今年还没有年度目标'}}</text>
          </view>
        </view>
        <app-icon name="chevron-right" size="30" />
      </view>
      <view class="goal-progress-row" wx:if="{{pigTotal}}">
        <text class="goal-owner">🐷 猪猪</text>
        <view class="goal-progress-track"><view class="goal-progress-fill pig" style="width: {{pigProgress}}%"></view></view>
        <text class="goal-progress-text">{{pigCompleted}}/{{pigTotal}}</text>
      </view>
      <view class="goal-progress-row" wx:if="{{donkeyTotal}}">
        <text class="goal-owner">🫏 毛驴</text>
        <view class="goal-progress-track"><view class="goal-progress-fill donkey" style="width: {{donkeyProgress}}%"></view></view>
        <text class="goal-progress-text">{{donkeyCompleted}}/{{donkeyTotal}}</text>
      </view>
    </view>
    <view class="section-error life-error" wx:elif="{{sectionStates.goals.status === 'error'}}">
      <view class="section-error-copy">
        <text class="section-error-title">年度目标暂不可用</text>
        <text class="section-error-message">{{sectionStates.goals.loading ? '正在重试…' : sectionStates.goals.error}}</text>
      </view>
      <button class="section-retry" size="mini" data-section="goals" bindtap="retryFailedSections" disabled="{{refreshing}}">重试</button>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
