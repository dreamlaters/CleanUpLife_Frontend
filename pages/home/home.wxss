.container {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.journal-hero {
  position: relative;
  min-height: 224rpx;
  margin: 18rpx 24rpx 26rpx;
  overflow: hidden;
  border: 1rpx solid #dfcdb8;
  border-radius: 26rpx 26rpx 26rpx 8rpx;
  background: #f5ebdd;
  box-shadow: 0 8rpx 24rpx rgba(91, 71, 55, 0.07);
}

.hero-copy {
  position: relative;
  z-index: 2;
  width: 57%;
  padding: 26rpx 0 22rpx 30rpx;
  display: flex;
  flex-direction: column;
}

.hero-eyebrow,
.section-kicker {
  color: #a66b56;
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: 12rpx;
  color: #3f352f;
  font-size: 35rpx;
  font-weight: 700;
  line-height: 1.35;
}

.hero-note {
  margin-top: 14rpx;
  color: #7d6e62;
  font-size: 23rpx;
}

.hero-illustration {
  position: absolute;
  right: -30rpx;
  bottom: -2rpx;
  width: 340rpx;
  height: 190rpx;
  opacity: 0.86;
}

.today-section,
.life-section {
  margin: 0 24rpx 26rpx;
}

.section-heading {
  margin: 0 2rpx 14rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.section-heading > view:first-child {
  display: flex;
  flex-direction: column;
}

.section-heading-copy {
  width: 100%;
}

.section-title-row {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  margin-top: 4rpx;
  color: #3f352f;
  font-size: 34rpx;
  font-weight: 700;
}

.section-count {
  min-width: 68rpx;
  height: 68rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #f4ded7;
  color: #9f4f3d;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.attention-card {
  overflow: hidden;
  border: 1rpx solid #e2d1bd;
  border-radius: 22rpx;
  background: #fffdf8;
  box-shadow: 0 4rpx 14rpx rgba(91, 71, 55, 0.05);
}

.attention-item {
  min-height: 96rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border-bottom: 1rpx dashed #eadfD2;
}

.attention-item:last-child {
  border-bottom: 0;
}

.attention-item:active {
  background: #faf3e9;
}

.attention-icon,
.all-clear-icon,
.life-card-icon,
.quick-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.attention-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
}

.attention-danger .attention-icon {
  background: #f6e1dd;
}

.attention-warning .attention-icon {
  background: #f6ead2;
}

.attention-live .attention-icon {
  background: #e2ebef;
}

.attention-savings .attention-icon {
  background: #f2dfc1;
}

.attention-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.attention-name {
  overflow: hidden;
  color: #3f352f;
  font-size: 27rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.attention-meta {
  margin-top: 3rpx;
  color: #8a7b6f;
  font-size: 21rpx;
}

.attention-status {
  padding: 5rpx 11rpx;
  border-radius: 8rpx;
  font-size: 19rpx;
  font-weight: 700;
}

.attention-danger .attention-status {
  background: #f6e1dd;
  color: #a54f47;
}

.attention-warning .attention-status {
  background: #f6ead2;
  color: #9c6d31;
}

.attention-live .attention-status {
  background: #e2ebef;
  color: #587181;
}

.attention-savings .attention-status {
  background: #f2dfc1;
  color: #8f6332;
}

.all-clear-card {
  min-height: 104rpx;
  padding: 0 22rpx;
  border: 1rpx solid #ccd9c6;
  border-radius: 22rpx 22rpx 22rpx 7rpx;
  background: #f1f5ed;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.all-clear-icon {
  width: 62rpx;
  height: 62rpx;
  border-radius: 20rpx;
  background: #dfe9d9;
}

.all-clear-copy {
  display: flex;
  flex-direction: column;
}

.all-clear-title {
  color: #4d6947;
  font-size: 27rpx;
  font-weight: 700;
}

.all-clear-text {
  margin-top: 4rpx;
  color: #788572;
  font-size: 21rpx;
}

.quick-grid {
  margin: 0 24rpx 30rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.quick-item {
  min-width: 0;
  padding: 20rpx 12rpx;
  border: 1rpx solid #e4d5c4;
  border-radius: 20rpx 20rpx 20rpx 7rpx;
  background: #fffdf8;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.18s ease;
}

.quick-item:active {
  transform: scale(0.96);
}

.quick-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 9rpx;
  border-radius: 17rpx;
}

.quick-icon-box { background: #f1e5d5; }
.quick-icon-cart { background: #e4ede0; }
.quick-icon-plane { background: #e2ebef; }
.quick-icon-cat { background: #f3e5c9; }
.quick-icon-savings { background: #f2dfc1; }

.quick-value {
  color: #3f352f;
  font-size: 35rpx;
  font-weight: 800;
  line-height: 1.2;
}

.quick-action-title {
  color: #3f352f;
  font-size: 26rpx;
  font-weight: 750;
  line-height: 1.3;
}

.quick-label {
  margin-top: 4rpx;
  color: #8a7b6f;
  font-size: 20rpx;
  white-space: nowrap;
}

.life-card,
.goals-note,
.savings-note {
  margin-bottom: 14rpx;
  border: 1rpx solid #e3d3c1;
  border-radius: 22rpx 22rpx 22rpx 7rpx;
  background: #fffdf8;
  box-shadow: 0 3rpx 12rpx rgba(91, 71, 55, 0.04);
}

.life-card {
  min-height: 116rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.life-card:active,
.goals-note:active,
.savings-note:active {
  background: #faf3e9;
}

.life-card-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
}

.period-icon { background: #f6e4e7; }
.cat-icon { background: #f2e6cf; }
.goal-icon { background: #e5ecdf; }
.savings-icon { background: #f2dfc1; }

.life-card-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.life-card-label {
  color: #9b7565;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.life-card-title {
  margin-top: 3rpx;
  color: #3f352f;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.4;
}

.life-card-meta {
  margin-top: 3rpx;
  color: #8a7b6f;
  font-size: 20rpx;
}

.cat-summary {
  margin-top: 5rpx;
  display: flex;
  gap: 20rpx;
}

.cat-summary-item {
  display: flex;
  align-items: baseline;
  gap: 5rpx;
}

.cat-name {
  color: #6a5c50;
  font-size: 21rpx;
}

.cat-weight {
  color: #3f352f;
  font-size: 26rpx;
  font-weight: 750;
}

.cat-date {
  color: #a3978b;
  font-size: 18rpx;
}

.goals-note {
  padding: 20rpx;
}

.goals-note-header,
.goals-note-title,
.goal-progress-row {
  display: flex;
  align-items: center;
}

.goals-note-header {
  justify-content: space-between;
}

.goals-note-title {
  gap: 14rpx;
}

.goal-progress-row {
  gap: 12rpx;
  margin-top: 16rpx;
}

.goal-owner {
  width: 92rpx;
  color: #6a5c50;
  font-size: 21rpx;
}

.goal-progress-track {
  flex: 1;
  height: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #eee4d8;
}

.goal-progress-fill {
  height: 100%;
  border-radius: inherit;
}

.goal-progress-fill.pig {
  background: #d58d9c;
}

.goal-progress-fill.donkey {
  background: #718999;
}

.goal-progress-text {
  width: 56rpx;
  color: #8a7b6f;
  font-size: 20rpx;
  text-align: right;
}

.savings-note {
  padding: 20rpx;
}

.savings-note-header,
.savings-title-wrap,
.savings-progress-copy,
.savings-checkin {
  display: flex;
  align-items: center;
}

.savings-note-header,
.savings-progress-copy {
  justify-content: space-between;
}

.savings-title-wrap {
  gap: 14rpx;
}

.savings-progress-copy {
  margin-top: 18rpx;
  color: #6a5c50;
  font-size: 21rpx;
}

.savings-remaining {
  color: #9f4f3d;
  font-weight: 650;
}

.savings-progress-track {
  height: 13rpx;
  margin-top: 9rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #eee4d8;
}

.savings-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: #c96f55;
}

.savings-checkin {
  gap: 8rpx;
  margin-top: 14rpx;
  color: #63755c;
  font-size: 20rpx;
}

.savings-checkin-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #6f8a65;
}

.savings-checkin-pending {
  color: #9c6d31;
}

.savings-checkin-pending .savings-checkin-dot {
  background: #c58a3f;
}
