/**
 * 记录页面样式
 * 猫猫体重 + 姨妈记录
 */

.container {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

/* ==================== 宠物卡片 ==================== */
.pet-cards {
  display: flex;
  gap: 12rpx;
  padding: 20rpx 24rpx;
}

.pet-card {
  flex: 1;
  background: #ffffff;
  border-radius: 22rpx;
  padding: 20rpx 14rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pet-card-accent {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: var(--accent-color);
}

.pet-avatar {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.pet-emoji {
  font-size: 40rpx;
}

.pet-info {
  text-align: center;
}

.pet-name {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 6rpx;
}

.pet-weight-wrap {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 2rpx;
}

.pet-weight {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
}

.pet-unit {
  font-size: 20rpx;
  color: #9ca3af;
}

/* ==================== 区块卡片 ==================== */
.section-card {
  width: auto;
  max-width: none;
  margin: 0 24rpx 16rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.section-icon {
  font-size: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.section-badge {
  font-size: 22rpx;
  color: #9ca3af;
  background: #f9fafb;
  padding: 6rpx 14rpx;
  border-radius: 14rpx;
}

/* ==================== 筛选标签 ==================== */
.filter-tabs {
  display: flex;
  gap: 8rpx;
  padding: 0 20rpx 16rpx;
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 22rpx;
  font-weight: 500;
  color: #6b7280;
  background: #f9fafb;
  border-radius: 12rpx;
  transition: all 0.2s ease;
  border: 1rpx solid #f3f4f6;
}

.filter-tab-active {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.3);
}

/* ==================== 图表区域 ==================== */
.chart-wrapper {
  padding: 0 18rpx 14rpx;
}

.chart-container {
  width: 100%;
  height: 340rpx;
  background: #f9fafb;
  border-radius: 18rpx;
  overflow: hidden;
}

.weight-canvas {
  width: 100%;
  height: 100%;
}

.chart-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.placeholder-icon {
  font-size: 44rpx;
}

.placeholder-text {
  font-size: 24rpx;
  color: #9ca3af;
}

.chart-legend {
  display: flex;
  justify-content: center;
  gap: 28rpx;
  padding: 6rpx 20rpx 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.legend-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

.legend-text {
  font-size: 22rpx;
  color: #6b7280;
}

/* ==================== 记录列表 ==================== */
.records-container {
  padding: 14rpx 18rpx 18rpx;
}

.person-group {
  margin-bottom: 20rpx;
}

.person-group:last-child {
  margin-bottom: 0;
}

.person-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6rpx;
  margin-bottom: 10rpx;
}

.person-info {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.person-emoji {
  font-size: 24rpx;
}

.person-name {
  font-size: 24rpx;
  font-weight: 600;
}

.person-badge {
  font-size: 18rpx;
  color: #9ca3af;
  background: #f9fafb;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.record-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
}

.record-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 8rpx;
  background: #f9fafb;
  border-radius: 14rpx;
  transition: all 0.2s ease;
  border: 1rpx solid transparent;
}

.record-card:active {
  transform: scale(0.96);
  background: #f3f4f6;
}

.record-date {
  font-size: 18rpx;
  color: #9ca3af;
  margin-bottom: 4rpx;
}

.record-value {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.record-weight {
  font-size: 28rpx;
  font-weight: 700;
}

.record-unit {
  font-size: 16rpx;
  color: #9ca3af;
}

/* ==================== 姨妈状态卡片 ==================== */
.period-status-card {
  margin: 20rpx 24rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #fdf2f8 0%, #fce7f3 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  border: 1rpx solid rgba(236, 72, 153, 0.1);
}

.period-status-icon {
  font-size: 56rpx;
}

.period-status-info {
  flex: 1;
}

.period-status-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.period-status-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #be185d;
}

.period-status-hint {
  font-size: 24rpx;
  color: #9ca3af;
}

/* ==================== 日历 ==================== */
.calendar-card {
  margin: 0 24rpx 16rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.calendar-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.month-nav {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f4f6;
  border-radius: 50%;
}

.nav-arrow {
  font-size: 36rpx;
  color: #6b7280;
  font-weight: 300;
}

.month-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.today-btn {
  padding: 8rpx 20rpx;
  background: #f3f4f6;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.weekday-row {
  display: flex;
  margin-bottom: 16rpx;
}

.weekday-cell {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
  font-weight: 500;
}

.weekday-cell .weekend {
  color: #ec4899;
}

.calendar-grid {
  display: flex;
  flex-wrap: wrap;
}

.day-cell {
  width: calc(100% / 7);
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  box-sizing: border-box;
}

.day-num {
  font-size: 28rpx;
  color: #374151;
  font-weight: 500;
}

.day-cell.other-month .day-num {
  color: #d1d5db;
}

.day-cell.today {
  background: #f3f4f6;
  border-radius: 50%;
}

.day-cell.today .day-num {
  color: #6366f1;
  font-weight: 700;
}

.day-cell.period {
  background: linear-gradient(135deg, #fce7f3 0%, #fbcfe8 100%);
  border-radius: 50%;
}

.day-cell.period .day-num {
  color: #be185d;
  font-weight: 600;
}

.day-cell.predicted {
  background: linear-gradient(135deg, #fdf2f8 0%, #fce7f3 100%);
  border-radius: 50%;
  border: 2rpx dashed #f9a8d4;
}

.day-cell.predicted .day-num {
  color: #db2777;
}

.day-cell.period-start,
.day-cell.period-end {
  background: linear-gradient(135deg, #ec4899 0%, #f472b6 100%);
}

.day-cell.period-start .day-num,
.day-cell.period-end .day-num {
  color: #fff;
}

.day-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #ec4899;
  position: absolute;
  bottom: 8rpx;
}

.day-cell.predicted .day-dot {
  background: #f9a8d4;
}

.period-legend {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f3f4f6;
}

.period-legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.period-legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.period-legend-dot.period {
  background: linear-gradient(135deg, #ec4899 0%, #f472b6 100%);
}

.period-legend-dot.predicted {
  background: #fce7f3;
  border: 2rpx dashed #f9a8d4;
}

/* ==================== 姨妈操作按钮 ==================== */
.period-action-buttons {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}

.period-action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.period-action-btn::after {
  border: none;
}

.period-action-btn.primary {
  background: linear-gradient(135deg, #ec4899 0%, #f472b6 100%);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(236, 72, 153, 0.3);
}

.period-action-btn.secondary {
  background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.3);
}

.period-action-btn.outline {
  background: #fff;
  color: #ec4899;
  border: 2rpx solid #ec4899;
}

.period-btn-icon {
  font-size: 28rpx;
}

/* ==================== 姨妈记录列表 ==================== */
.period-record-list {
  padding: 8rpx;
}

.period-record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.period-record-item:last-child {
  border-bottom: none;
}

.period-record-item:active {
  background: #f9fafb;
}

.period-record-dates {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.period-record-start,
.period-record-end {
  font-size: 26rpx;
  color: #374151;
}

.period-record-arrow {
  font-size: 24rpx;
  color: #9ca3af;
}

.period-record-info {
  display: flex;
  gap: 16rpx;
}

.period-record-days {
  font-size: 24rpx;
  color: #ec4899;
  background: #fce7f3;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.period-record-cycle {
  font-size: 24rpx;
  color: #6b7280;
  background: #f3f4f6;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* ==================== 弹窗样式 ==================== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.modal-overlay.show {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  width: 100%;
  max-height: 85vh;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  overflow: hidden;
  animation: slideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #9ca3af;
  border-radius: 50%;
  background: #f9fafb;
}

.modal-body {
  padding: 32rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.modal-footer {
  padding: 16rpx 32rpx 24rpx;
  display: flex;
  gap: 12rpx;
}

/* ==================== 表单元素 ==================== */
.form-group {
  margin-bottom: 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #6b7280;
  margin-bottom: 10rpx;
  display: block;
}

.form-input {
  width: 100%;
  padding: 20rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #374151;
  box-sizing: border-box;
}

.person-selector {
  display: flex;
  gap: 12rpx;
}

.person-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 18rpx 14rpx;
  background: #f9fafb;
  border-radius: 16rpx;
  transition: all 0.2s ease;
  border: 2rpx solid transparent;
}

.person-option-active {
  background: rgba(99, 102, 241, 0.08);
  border-color: #6366f1;
}

.option-emoji {
  font-size: 32rpx;
}

.option-name {
  font-size: 22rpx;
  color: #6b7280;
  font-weight: 500;
}

.person-option-active .option-name {
  color: #6366f1;
}

.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
}

.weight-input {
  flex: 1;
  min-width: 0;
  width: 100%;
  min-height: 80rpx !important;
  line-height: 80rpx !important;
  padding: 0 80rpx 0 24rpx !important;
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  font-size: 32rpx;
  color: #111827;
  box-sizing: border-box;
}

.weight-input:focus {
  background: #ffffff;
  border-color: #6366f1;
}

.input-suffix {
  position: absolute;
  right: 24rpx;
  color: #9ca3af;
  font-size: 28rpx;
  pointer-events: none;
}

.date-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 20rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  color: #374151;
}

.date-value {
  flex: 1;
}

.picker-arrow {
  font-size: 28rpx;
  color: #9ca3af;
}

/* ==================== 按钮 ==================== */
.btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  border: none;
}

.btn::after {
  border: none;
}

.btn-secondary {
  background: #f3f4f6;
  color: #6b7280;
}

.btn-primary {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #fff;
}

.btn-primary.btn-pink {
  background: linear-gradient(135deg, #ec4899 0%, #f472b6 100%);
}

.btn-danger {
  background: linear-gradient(135deg, #ef4444 0%, #f87171 100%);
  color: #fff;
}

/* ==================== 体检相关样式 ==================== */

/* 人员切换 */
.checkup-owner-tabs {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
}

.checkup-owner-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 16rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
  border: 2rpx solid transparent;
}

.checkup-owner-tab-active {
  background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
  border-color: #6366f1;
  box-shadow: 0 4rpx 16rpx rgba(99, 102, 241, 0.15);
}

.checkup-owner-emoji {
  font-size: 36rpx;
}

.checkup-owner-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #374151;
}

.checkup-owner-tab-active .checkup-owner-name {
  color: #6366f1;
  font-weight: 600;
}

/* 概览卡片 */
.checkup-summary-card {
  margin: 0 24rpx 20rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(99, 102, 241, 0.3);
}

.checkup-summary-icon {
  font-size: 48rpx;
}

.checkup-summary-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.checkup-summary-title {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.checkup-summary-date {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.checkup-summary-hospital {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.checkup-summary-stats {
  display: flex;
  gap: 16rpx;
}

.checkup-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  min-width: 72rpx;
}

.checkup-stat-num {
  font-size: 32rpx;
  font-weight: 700;
}

.checkup-stat-num.abnormal {
  color: #fbbf24;
}

.checkup-stat-num.normal {
  color: #fff;
}

.checkup-stat-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 记录列表 */
.checkup-record-list {
  padding: 0;
}

.checkup-record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
  transition: background 0.15s;
}

.checkup-record-item:last-child {
  border-bottom: none;
}

.checkup-record-item:active {
  background: #f9fafb;
}

.checkup-record-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.checkup-record-date {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.checkup-record-hospital {
  font-size: 24rpx;
  color: #9ca3af;
}

.checkup-record-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.checkup-badge {
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.checkup-badge.abnormal {
  background: #fef3c7;
  color: #92400e;
}

.checkup-badge.normal {
  background: #ecfdf5;
  color: #065f46;
}

.checkup-record-arrow {
  font-size: 32rpx;
  color: #d1d5db;
  margin-left: 4rpx;
}

/* ==================== 猫猫记录子切换 ==================== */
.cat-subtabs {
  display: flex;
  gap: 8rpx;
  margin: 16rpx 24rpx 4rpx;
  background: #eef2f7;
  border-radius: 16rpx;
  padding: 6rpx;
}

.cat-subtab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 16rpx 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #6b7280;
  border-radius: 12rpx;
  transition: all .2s;
}

.cat-subtab-active {
  background: #ffffff;
  color: #6366f1;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.cat-subtab-icon {
  font-size: 28rpx;
}

/* 通用：列表底部提示 */
.more-hint {
  text-align: center;
  font-size: 22rpx;
  color: #9ca3af;
  padding: 12rpx 0 4rpx;
}

/* ==================== 陪玩：当前账号 ==================== */
.play-identity {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 12rpx 24rpx 0;
  padding: 12rpx 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  width: fit-content;
}

.play-identity-label {
  font-size: 22rpx;
  color: #9ca3af;
}

.play-identity-emoji {
  font-size: 30rpx;
}

.play-identity-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #111827;
}

/* ==================== 陪玩：开始 / 进行中 ==================== */
.play-action-card {
  margin: 16rpx 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  padding: 36rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: box-shadow .3s;
}

/* 进行中：卡片透出一点"活着"的暖意 */
.play-action-card-live {
  background: linear-gradient(180deg, #ffffff 0%, #fafaff 100%);
  box-shadow: 0 6rpx 24rpx rgba(99, 102, 241, 0.12);
}

.play-start-btn {
  position: relative;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 40rpx 0;
  border: none;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #6366f1 0%, #818cf8 45%, #8b5cf6 100%);
  color: #fff;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  /* 黏土双阴影：外投影 + 顶部高光 + 底部暗边（厚度感） */
  box-shadow:
    0 12rpx 28rpx rgba(99, 102, 241, 0.40),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.45),
    inset 0 -6rpx 12rpx rgba(67, 56, 202, 0.35);
  animation: playBreathe 2.8s ease-in-out infinite;
  transition: transform .18s cubic-bezier(0.16, 1, 0.3, 1), box-shadow .18s;
}

.play-start-btn::after {
  border: none;
}

.play-start-btn:active {
  transform: scale(0.95);
  box-shadow:
    0 4rpx 12rpx rgba(99, 102, 241, 0.30),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.35),
    inset 0 -3rpx 8rpx rgba(67, 56, 202, 0.30);
  animation: none;
}

.play-start-btn[disabled] {
  opacity: .6;
  animation: none;
}

/* 轻微"呼吸"：像在邀请你来陪玩 */
@keyframes playBreathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.025); }
}

.play-start-icon {
  font-size: 44rpx;
}

.play-start-text {
  letter-spacing: 4rpx;
}

.play-start-hint {
  margin-top: 18rpx;
  font-size: 23rpx;
  color: #9ca3af;
}

.play-live {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: #fef2f2;
  box-shadow: inset 0 2rpx 5rpx rgba(239, 68, 68, 0.10);
  margin-bottom: 18rpx;
}

.play-live-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ef4444;
  animation: playPulse 1.2s infinite;
}

@keyframes playPulse {
  0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.5); }
  70% { box-shadow: 0 0 0 14rpx rgba(239, 68, 68, 0); }
  100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
}

.play-live-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #ef4444;
}

.play-live-timer-well {
  width: 100%;
  display: flex;
  justify-content: center;
  padding: 22rpx 0;
  border-radius: 28rpx;
  background: #f6f7fb;
  /* 内凹"压进去"的黏土井，与凸起的按钮形成凸/凹对比 */
  box-shadow:
    inset 0 4rpx 10rpx rgba(67, 56, 202, 0.10),
    inset 0 -2rpx 0 rgba(255, 255, 255, 0.9);
  margin-bottom: 28rpx;
}

.play-live-timer {
  font-size: 80rpx;
  font-weight: 800;
  color: #1f2937;
  letter-spacing: 4rpx;
}

.play-live-btns {
  display: flex;
  gap: 16rpx;
  width: 100%;
}

.play-btn {
  flex: 1;
  padding: 28rpx 0;
  border: none;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  transition: transform .16s cubic-bezier(0.16, 1, 0.3, 1), box-shadow .16s;
}

.play-btn::after {
  border: none;
}

.play-btn:active {
  transform: scale(0.95);
}

.play-btn-end {
  flex: 2;
  background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
  color: #fff;
  /* 黏土双阴影：外投影 + 顶部高光 + 底部暗边 */
  box-shadow:
    0 10rpx 22rpx rgba(16, 185, 129, 0.38),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.45),
    inset 0 -5rpx 10rpx rgba(5, 150, 105, 0.35);
}

.play-btn-end:active {
  box-shadow:
    0 4rpx 10rpx rgba(16, 185, 129, 0.30),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.35),
    inset 0 -3rpx 8rpx rgba(5, 150, 105, 0.30);
}

.play-btn-end[disabled] {
  opacity: .6;
}

.play-btn-discard {
  background: #eef0f4;
  color: #6b7280;
  /* 软凸起的中性键 */
  box-shadow:
    inset 0 3rpx 0 rgba(255, 255, 255, 0.9),
    inset 0 -4rpx 8rpx rgba(0, 0, 0, 0.06),
    0 4rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* ==================== 陪玩：统计 ==================== */
.play-stats {
  padding: 8rpx 8rpx 16rpx;
}

.play-stat-row {
  display: flex;
