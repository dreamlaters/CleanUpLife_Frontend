<!-- 记录页面 - 猫猫体重 + 姨妈记录 + 体检记录 -->
<view class="container">
  <!-- 自定义导航栏 -->
  <custom-navbar title="我的记录" statusBarHeight="{{statusBarHeight}}" navbarHeight="{{navbarHeight}}" />

  <!-- 顶部记录分类 -->
  <segmented-control items="{{recordTabs}}" value="{{currentTab}}" bind:change="switchTab" />

  <!-- ==================== 猫猫记录内容（体重 / 陪玩） ==================== -->
  <view class="tab-content" wx:if="{{currentTab === 'weight'}}">
    <!-- 子切换：体重 / 陪玩 -->
    <view class="cat-subtabs">
      <segmented-control items="{{catTabs}}" value="{{catSubTab}}" bind:change="switchCatSubTab" />
    </view>

  <!-- ===== 体重子页 ===== -->
  <block wx:if="{{catSubTab === 'weight'}}">
    <!-- 宠物卡片 -->
    <view class="pet-cards">
      <view 
        class="pet-card" 
        wx:for="{{personList}}" 
        wx:key="*this" 
        wx:for-item="person"
        style="--accent-color: {{personConfig[person].color}}"
      >
        <view class="pet-card-accent"></view>
        <view class="pet-avatar">
          <text class="pet-emoji">{{personConfig[person].emoji}}</text>
        </view>
        <view class="pet-info">
          <text class="pet-name">{{person}}</text>
          <view class="pet-weight-wrap">
            <text class="pet-weight">{{latestWeights[person] || '--'}}</text>
            <text class="pet-unit">斤</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 图表区域 -->
    <view class="section-card">
      <view class="section-header">
        <view class="section-title-wrap">
          <view class="section-icon"><app-icon name="trend" size="32" label="趋势" /></view>
          <text class="section-title">体重趋势</text>
        </view>
      </view>
      
      <!-- 时间范围筛选 -->
      <view class="filter-tabs">
        <view class="filter-tab {{timeRange === 'week' ? 'filter-tab-active' : ''}}" 
              bindtap="onTimeRangeChange" data-range="week">近7天</view>
        <view class="filter-tab {{timeRange === 'month' ? 'filter-tab-active' : ''}}" 
              bindtap="onTimeRangeChange" data-range="month">近30天</view>
        <view class="filter-tab {{timeRange === '3month' ? 'filter-tab-active' : ''}}" 
              bindtap="onTimeRangeChange" data-range="3month">近3月</view>
        <view class="filter-tab {{timeRange === 'all' ? 'filter-tab-active' : ''}}" 
              bindtap="onTimeRangeChange" data-range="all">全部</view>
      </view>

      <!-- Canvas 折线图 -->
      <view class="chart-wrapper">
        <view class="chart-container" wx:if="{{!showWeightForm}}">
          <canvas type="2d" id="weight-canvas" class="weight-canvas"></canvas>
        </view>
        <view class="chart-container chart-placeholder" wx:else>
          <view class="placeholder-icon"><app-icon name="trend" size="52" label="图表" /></view>
          <text class="placeholder-text">编辑中...</text>
        </view>
      </view>

      <!-- 图例 -->
      <view class="chart-legend">
        <view class="legend-item" wx:for="{{personList}}" wx:key="*this" wx:for-item="person">
          <view class="legend-dot" style="background: {{personConfig[person].color}}"></view>
          <text class="legend-text">{{person}}</text>
        </view>
      </view>
    </view>

    <!-- 记录列表 -->
    <view class="section-card">
      <view class="section-header">
        <view class="section-title-wrap">
          <view class="section-icon"><app-icon name="calendar" size="32" label="记录" /></view>
          <text class="section-title">记录明细</text>
        </view>
        <view class="section-badge" wx:if="{{weightRecords.length}}">{{weightRecords.length}}条</view>
      </view>

      <loading-state loading="{{loadingWeight}}" />

      <view class="records-container" wx:if="{{!loadingWeight && weightRecords.length}}">
        <view class="person-group" wx:for="{{personList}}" wx:key="*this" wx:for-item="person" wx:if="{{groupedRecords[person].length}}">
          <view class="person-header">
            <view class="person-info">
              <text class="person-emoji">{{personConfig[person].emoji}}</text>
              <text class="person-name" style="color: {{personConfig[person].color}}">{{person}}</text>
            </view>
            <view class="person-badge">{{groupedRecords[person].length}}条</view>
          </view>
          
          <view class="record-grid">
            <view
              class="record-card"
              wx:for="{{displayRecords[person]}}"
              wx:key="id"
              wx:for-item="record"
              data-id="{{record.id}}"
              data-person="{{person}}"
              bindtap="onWeightRecordTap"
              bindlongpress="onWeightRecordLongPress"
            >
              <text class="record-date">{{record.recordDateFormatted}}</text>
              <view class="record-value" style="color: {{personConfig[person].color}}">
                <text class="record-weight">{{record.weight}}</text>
                <text class="record-unit">斤</text>
              </view>
            </view>
          </view>
          <view class="more-hint" wx:if="{{groupedRecords[person].length > 6}}">仅显示最近 6 条</view>
        </view>
      </view>

      <view class="empty-state" wx:if="{{!loadingWeight && !weightRecords.length}}">
        <view class="empty-icon"><app-icon name="trend" size="56" label="体重" /></view>
        <text class="empty-title">还没有体重记录</text>
        <text class="empty-text">点击下方按钮，开始记录宝贝的体重</text>
        <button class="empty-action" bindtap="showAddWeightForm">添加记录</button>
      </view>
    </view>

    <!-- 悬浮添加按钮 -->
    <view class="fab-btn" bindtap="showAddWeightForm" wx:if="{{!showWeightForm}}">
      <app-icon name="plus" size="44" label="添加体重记录" />
    </view>

    <!-- 底部消息推送入口 -->
    <footer-link />
  </block>

  <!-- ===== 陪玩子页 ===== -->
  <block wx:if="{{catSubTab === 'play'}}">
    <!-- 当前账号身份 -->
    <view class="play-identity" wx:if="{{playStatus}}">
      <text class="play-identity-label">当前账号</text>
      <text class="play-identity-emoji">{{playerConfig[playStatus.player].emoji}}</text>
      <text class="play-identity-name">{{playerConfig[playStatus.player].name}}</text>
    </view>

    <!-- 开始 / 进行中 -->
    <view class="play-action-card {{playStatus && playStatus.ongoing ? 'play-action-card-live' : ''}}">
      <block wx:if="{{playStatus && playStatus.ongoing}}">
        <view class="play-live">
          <view class="play-live-dot"></view>
          <text class="play-live-label">正在陪玩</text>
        </view>
        <view class="play-live-timer-well">
          <text class="play-live-timer">{{playElapsedText}}</text>
        </view>
        <view class="play-live-btns">
          <button class="play-btn play-btn-end" bindtap="onEndPlay" disabled="{{playStarting}}">结束陪玩</button>
          <button class="play-btn play-btn-discard" bindtap="onDiscardPlay">放弃</button>
        </view>
      </block>
      <block wx:else>
        <button class="play-start-btn" bindtap="onStartPlay" disabled="{{playStarting}}">
          <view class="play-start-icon"><app-icon name="timer" size="42" label="计时" /></view>
          <text class="play-start-text">开始陪玩</text>
        </button>
        <text class="play-start-hint">点击开始，自动记录你的陪玩时间</text>
      </block>
    </view>

    <!-- 统计 -->
    <view class="section-card">
      <view class="section-header">
        <view class="section-title-wrap">
          <view class="section-icon"><app-icon name="trend" size="32" label="统计" /></view>
          <text class="section-title">陪玩统计</text>
        </view>
      </view>

      <view class="filter-tabs">
        <view class="filter-tab {{playStatsRange === 'week' ? 'filter-tab-active' : ''}}"
              bindtap="onPlayStatsRangeChange" data-range="week">近7天</view>
        <view class="filter-tab {{playStatsRange === 'month' ? 'filter-tab-active' : ''}}"
              bindtap="onPlayStatsRangeChange" data-range="month">近30天</view>
        <view class="filter-tab {{playStatsRange === 'year' ? 'filter-tab-active' : ''}}"
              bindtap="onPlayStatsRangeChange" data-range="year">近1年</view>
      </view>

      <view class="play-stats" wx:if="{{playStatsView}}">
        <view class="play-stat-row">
          <view class="play-stat-who">
            <text class="play-stat-emoji">🐷</text>
            <text class="play-stat-name">猪猪</text>
          </view>
          <view class="play-stat-val">
            <text class="play-stat-time">{{playStatsView[playStatsRange].pig}}</text>
            <text class="play-stat-sessions">{{playStatsView[playStatsRange].pigSessions}} 次</text>
          </view>
        </view>
        <view class="play-stat-row">
          <view class="play-stat-who">
            <text class="play-stat-emoji">🫏</text>
            <text class="play-stat-name">毛驴</text>
          </view>
          <view class="play-stat-val">
            <text class="play-stat-time">{{playStatsView[playStatsRange].donkey}}</text>
            <text class="play-stat-sessions">{{playStatsView[playStatsRange].donkeySessions}} 次</text>
          </view>
        </view>
        <view class="play-stat-row" wx:if="{{playStatsView[playStatsRange].otherSecondsRaw > 0}}">
          <view class="play-stat-who">
            <text class="play-stat-emoji">👤</text>
            <text class="play-stat-name">其他</text>
          </view>
          <view class="play-stat-val">
            <text class="play-stat-time">{{playStatsView[playStatsRange].other}}</text>
            <text class="play-stat-sessions">{{playStatsView[playStatsRange].otherSessions}} 次</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 历史记录 -->
    <view class="section-card">
      <view class="section-header">
        <view class="section-title-wrap">
          <view class="section-icon"><app-icon name="calendar" size="32" label="记录" /></view>
          <text class="section-title">陪玩记录</text>
        </view>
        <view class="section-badge" wx:if="{{playRecords.length}}">{{playRecords.length}}条</view>
      </view>

      <loading-state loading="{{loadingPlay}}" />

      <view class="play-record-list" wx:if="{{!loadingPlay && playRecords.length}}">
        <view class="play-record-item" wx:for="{{playRecords}}" wx:key="id"
              data-id="{{item.id}}" data-record="{{item}}"
              bindtap="onPlayRecordTap" bindlongpress="onPlayRecordLongPress">
          <view class="play-record-left">
            <text class="play-record-emoji">{{item.playerEmoji}}</text>
            <view class="play-record-info">
              <view class="play-record-namerow">
                <text class="play-record-name" style="color: {{item.playerColor}}">{{item.playerName}}</text>
                <text class="play-record-mine" wx:if="{{item.isMine}}">我</text>
              </view>
              <text class="play-record-range">{{item.rangeStr}}</text>
            </view>
          </view>
          <text class="play-record-duration {{item.ongoing ? 'ongoing' : ''}}">{{item.durationStr}}</text>
        </view>
        <view class="more-hint">仅可编辑 / 删除自己（带"我"）的记录</view>
      </view>

      <view class="empty-state" wx:if="{{!loadingPlay && !playRecords.length}}">
        <view class="empty-icon"><app-icon name="timer" size="56" label="陪玩" /></view>
        <text class="empty-title">还没有陪玩记录</text>
        <text class="empty-text">点击上方「开始陪玩」记录第一次</text>
      </view>
    </view>

    <!-- 底部消息推送入口 -->
    <footer-link />
  </block>
  </view>

  <!-- ==================== 姨妈内容 ==================== -->
  <view class="tab-content" wx:if="{{currentTab === 'period'}}">
    <!-- 状态卡片 -->
    <view class="period-status-card" wx:if="{{periodStats}}">
      <view class="period-status-icon"><app-icon name="flower" size="52" label="经期状态" /></view>
      <view class="period-status-info">
        <view class="period-status-main" wx:if="{{periodStats.status === 'none'}}">
          <text class="period-status-text">暂无记录</text>
          <text class="period-status-hint">点击下方按钮开始记录</text>
        </view>
        <view class="period-status-main" wx:elif="{{periodStats.status === 'in-period'}}">
          <text class="period-status-text">经期第 {{periodDays}} 天</text>
          <text class="period-status-hint">记得注意保暖，好好休息</text>
        </view>
        <view class="period-status-main" wx:else>
          <text class="period-status-text" wx:if="{{periodStats.daysUntilNextPeriod > 0}}">距下次姨妈还有 {{periodStats.daysUntilNextPeriod}} 天
          </text>
          <text class="period-status-text" wx:elif="{{periodStats.daysUntilNextPeriod === 0}}">预计今天开始</text>
          <text class="period-status-text" wx:else>已超出预计 {{0 - periodStats.daysUntilNextPeriod}} 天</text>
          <text class="period-status-hint">平均周期 {{periodStats.averageCycleDays}} 天</text>
        </view>
      </view>
    </view>

    <!-- 日历区域 -->
    <view class="calendar-card">
      <!-- 月份导航 -->
      <view class="calendar-header">
        <view class="month-nav" bindtap="prevMonth">
          <view class="nav-arrow nav-arrow-left"><app-icon name="chevron-right" size="28" label="上个月" /></view>
        </view>
        <view class="month-title">
          <text>{{currentYear}}年{{currentMonth}}月</text>
        </view>
        <view class="month-nav" bindtap="nextMonth">
          <view class="nav-arrow"><app-icon name="chevron-right" size="28" label="下个月" /></view>
        </view>
        <view class="today-btn" bindtap="goToToday">
          <text>今天</text>
        </view>
      </view>

      <!-- 星期标题 -->
      <view class="weekday-row">
        <view class="weekday-cell" wx:for="{{weekDays}}" wx:key="*this">
          <text class="{{index === 0 || index === 6 ? 'weekend' : ''}}">{{item}}</text>
        </view>
      </view>

      <!-- 日期网格 -->
      <view class="calendar-grid">
        <view 
          class="day-cell {{item.isCurrentMonth ? '' : 'other-month'}} {{item.isToday ? 'today' : ''}} {{item.isPeriod ? 'period' : ''}} {{item.isPredicted ? 'predicted' : ''}} {{item.isStart ? 'period-start' : ''}} {{item.isEnd ? 'period-end' : ''}}"
          wx:for="{{calendarDays}}" 
          wx:key="date"
        >
          <text class="day-num">{{item.day}}</text>
          <view class="day-dot" wx:if="{{item.isPeriod || item.isPredicted}}"></view>
        </view>
      </view>

      <!-- 图例 -->
      <view class="period-legend">
        <view class="period-legend-item">
          <view class="period-legend-dot period"></view>
          <text>经期</text>
        </view>
        <view class="period-legend-item">
          <view class="period-legend-dot predicted"></view>
          <text>预测</text>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="period-action-buttons">
      <button class="period-action-btn primary" bindtap="showRecordStart" wx:if="{{!latestPeriodRecord || latestPeriodRecord.endDate}}">
        <view class="period-btn-icon"><app-icon name="flower" size="30" label="开始" /></view>
        <text>记录开始</text>
      </button>
      <button class="period-action-btn secondary" bindtap="showRecordEnd" wx:if="{{latestPeriodRecord && !latestPeriodRecord.endDate}}">
        <view class="period-btn-icon"><app-icon name="check" size="30" label="结束" /></view>
        <text>记录结束</text>
      </button>
      <button class="period-action-btn outline" bindtap="showRecordStart" wx:if="{{latestPeriodRecord && !latestPeriodRecord.endDate}}">
        <view class="period-btn-icon"><app-icon name="edit" size="30" label="新记录" /></view>
        <text>新记录</text>
      </button>
    </view>

    <!-- 历史记录列表 -->
    <view class="section-card" wx:if="{{periodRecords.length > 0}}">
      <view class="section-header">
        <view class="section-title-wrap">
          <view class="section-icon"><app-icon name="calendar" size="32" label="历史记录" /></view>
          <text class="section-title">历史记录</text>
        </view>
      </view>
      <view class="period-record-list">
        <view 
          class="period-record-item" 
          wx:for="{{periodRecords}}" 
          wx:key="id"
          bindtap="onPeriodRecordTap"
          data-record="{{item}}"
        >
          <view class="period-record-dates">
            <text class="period-record-start">{{item.startDateDisplay}}</text>
            <text class="period-record-arrow">→</text>
            <text class="period-record-end">{{item.endDateDisplay || '进行中'}}</text>
          </view>
          <view class="period-record-info">
            <text class="period-record-days" wx:if="{{item.periodDays}}">{{item.periodDays}}天</text>
            <text class="period-record-cycle" wx:if="{{item.cycleDays}}">周期{{item.cycleDays}}天</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部消息推送入口 -->
    <footer-link />

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!loadingPeriod && periodRecords.length === 0}}">
      <view class="empty-icon"><app-icon name="calendar" size="56" label="日历" /></view>
      <text class="empty-title">暂无记录</text>
      <text class="empty-text">点击"记录开始"添加第一条记录</text>
    </view>

    <!-- 加载状态 -->
    <loading-state loading="{{loadingPeriod}}" />
  </view>
  <!-- ==================== 体检内容 ==================== -->
  <view class="tab-content" wx:if="{{currentTab === 'checkup'}}">
    <!-- 人员切换 -->
    <view class="checkup-owner-tabs">
      <view 
        class="checkup-owner-tab {{checkupOwner === item ? 'checkup-owner-tab-active' : ''}}"
        wx:for="{{checkupOwners}}"
        wx:key="*this"
        wx:for-item="item"
        bindtap="onCheckupOwnerChange"
        data-owner="{{item}}"
      >
        <text class="checkup-owner-emoji">{{checkupOwnerConfig[item].emoji}}</text>
        <text class="checkup-owner-name">{{checkupOwnerConfig[item].name}}</text>
      </view>
    </view>

    <!-- 加载状态 -->
    <loading-state loading="{{loadingCheckup}}" />

    <!-- 最近体检概览卡片 -->
    <view class="checkup-summary-card" wx:if="{{checkupRecords.length > 0 && !loadingCheckup}}">
      <view class="checkup-summary-icon"><app-icon name="health" size="52" label="体检" /></view>
      <view class="checkup-summary-info">
        <text class="checkup-summary-title">最近一次体检</text>
        <text class="checkup-summary-date">{{checkupRecords[0].checkupDateFormatted}}</text>
        <text class="checkup-summary-hospital" wx:if="{{checkupRecords[0].hospital}}">{{checkupRecords[0].hospital}}</text>
      </view>
      <view class="checkup-summary-stats">
        <view class="checkup-stat-item" wx:if="{{checkupRecords[0].abnormalCount > 0}}">
          <text class="checkup-stat-num abnormal">{{checkupRecords[0].abnormalCount}}</text>
          <text class="checkup-stat-label">异常</text>
        </view>
        <view class="checkup-stat-item">
          <text class="checkup-stat-num normal">{{checkupRecords[0].normalCount}}</text>
          <text class="checkup-stat-label">正常</text>
        </view>
      </view>
    </view>

    <!-- 体检记录列表 -->
    <view class="section-card" wx:if="{{checkupRecords.length > 0 && !loadingCheckup}}">
      <view class="section-header">
        <view class="section-title-wrap">
          <view class="section-icon"><app-icon name="calendar" size="32" label="历史记录" /></view>
          <text class="section-title">历史记录</text>
        </view>
        <view class="section-badge">{{checkupRecords.length}}次</view>
      </view>

      <view class="checkup-record-list">
        <view 
          class="checkup-record-item"
          wx:for="{{checkupRecords}}"
          wx:key="id"
          bindtap="goToCheckupDetail"
          bindlongpress="onCheckupLongPress"
          data-id="{{item.id}}"
        >
          <view class="checkup-record-left">
            <text class="checkup-record-date">{{item.checkupDateFormatted}}</text>
            <text class="checkup-record-hospital" wx:if="{{item.hospital}}">{{item.hospital}}</text>
          </view>
          <view class="checkup-record-right">
            <view class="checkup-badge abnormal" wx:if="{{item.abnormalCount > 0}}">
              <app-icon name="alert" size="24" label="异常" />
              <text>{{item.abnormalCount}}项异常</text>
            </view>
            <view class="checkup-badge normal">
              <app-icon name="check" size="24" label="正常" />
              <text>{{item.normalCount}}项正常</text>
            </view>
            <view class="checkup-record-arrow"><app-icon name="chevron-right" size="28" label="查看详情" /></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!loadingCheckup && checkupRecords.length === 0}}">
      <view class="empty-icon"><app-icon name="health" size="56" label="体检" /></view>
      <text class="empty-title">暂无体检记录</text>
      <text class="empty-text">点击下方按钮，开始记录体检结果</text>
    </view>

    <!-- 悬浮添加按钮 -->
    <view class="fab-btn" bindtap="goToAddCheckup">
      <app-icon name="plus" size="44" label="添加体检记录" />
    </view>

    <!-- 底部消息推送入口 -->
    <footer-link />
  </view>
  <view class="safe-bottom"></view>
</view>

<!-- ==================== 体重表单弹窗 ==================== -->
<view class="modal-overlay {{showWeightForm ? 'show' : ''}}" catchtap="hideWeightForm" wx:if="{{showWeightForm}}">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-header">
      <view class="modal-title">
        <app-icon name="{{editingWeightId ? 'edit' : 'plus'}}" size="30" />
        <text>{{editingWeightId ? '编辑记录' : '添加记录'}}</text>
      </view>
      <view class="modal-close" bindtap="hideWeightForm">×</view>
    </view>

    <view class="modal-body" catchtap="stopPropagation">
      <view class="form-group">
        <view class="form-label form-label-row"><app-icon name="cat" size="26" /><text>选择宝贝</text></view>
        <view class="person-selector">
          <view 
            class="person-option {{formPersonIndex === index ? 'person-option-active' : ''}}"
            wx:for="{{personList}}"
            wx:key="*this"
            wx:for-item="person"
            data-index="{{index}}"
            bindtap="onPersonSelect"
            style="--person-color: {{personConfig[person].color}}"
          >
            <text class="option-emoji">{{personConfig[person].emoji}}</text>
            <text class="option-name">{{person}}</text>
          </view>
        </view>
      </view>

      <view class="form-group">
        <view class="form-label form-label-row"><app-icon name="trend" size="26" /><text>体重（斤）</text></view>
        <view class="input-wrapper">
          <input 
            class="weight-input" 
            type="digit" 
            placeholder="请输入体重"
            value="{{formWeight}}"
            bindinput="onWeightInput"
          />
          <text class="input-suffix">斤</text>
        </view>
      </view>

      <view class="form-group">
        <view class="form-label form-label-row"><app-icon name="calendar" size="26" /><text>记录日期</text></view>
        <picker mode="date" value="{{formDate}}" bindchange="onWeightDateChange">
          <view class="date-picker">
            <text class="date-value">{{formDate}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
    </view>

    <view class="modal-footer">
      <button class="btn btn-secondary" bindtap="hideWeightForm">取消</button>
      <button class="btn btn-primary" bindtap="submitWeightForm">确定</button>
    </view>
  </view>
</view>

<!-- 体重操作菜单 -->
<action-sheet
  show="{{showWeightActionSheet}}" title="{{weightActionSheetPerson}} 的记录"
  bind:edit="onEditWeightAction" bind:delete="onDeleteWeightAction" bind:cancel="hideWeightActionSheet"
/>

<!-- ==================== 姨妈弹窗 ==================== -->
<!-- 记录开始弹窗 -->
<view class="modal-overlay {{showStartModal ? 'show' : ''}}" catchtap="hideStartModal" wx:if="{{showStartModal}}">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">记录开始日期</text>
      <view class="modal-close" bindtap="hideStartModal">×</view>
    </view>
    <view class="modal-body">
      <view class="form-group">
        <text class="form-label">开始日期</text>
        <picker mode="date" value="{{startDate}}" bindchange="onStartDateChange">
          <view class="date-picker">
            <text class="date-value">{{startDate}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
      <view class="form-group">
        <text class="form-label">备注（可选）</text>
        <input class="form-input" placeholder="添加备注..." value="{{notes}}" bindinput="onNotesInput" />
      </view>
    </view>
    <view class="modal-footer">
      <button class="btn btn-secondary" bindtap="hideStartModal">取消</button>
      <button class="btn btn-primary btn-pink" bindtap="submitStart">确定</button>
    </view>
  </view>
</view>

<!-- 记录结束弹窗 -->
<view class="modal-overlay {{showEndModal ? 'show' : ''}}" catchtap="hideEndModal" wx:if="{{showEndModal}}">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">记录结束日期</text>
      <view class="modal-close" bindtap="hideEndModal">×</view>
    </view>
    <view class="modal-body">
      <view class="form-group">
        <text class="form-label">结束日期</text>
        <picker mode="date" value="{{endDate}}" bindchange="onEndDateChange">
          <view class="date-picker">
            <text class="date-value">{{endDate}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
    </view>
    <view class="modal-footer">
      <button class="btn btn-secondary" bindtap="hideEndModal">取消</button>
      <button class="btn btn-primary btn-pink" bindtap="submitEnd">确定</button>
    </view>
  </view>
</view>

<!-- 编辑弹窗 -->
<view class="modal-overlay {{showPeriodEditModal ? 'show' : ''}}" catchtap="hidePeriodEditModal" wx:if="{{showPeriodEditModal}}">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">编辑记录</text>
      <view class="modal-close" bindtap="hidePeriodEditModal">×</view>
    </view>
    <view class="modal-body">
      <view class="form-group">
        <text class="form-label">开始日期</text>
        <picker mode="date" value="{{editStartDate}}" bindchange="onEditStartDateChange">
          <view class="date-picker">
            <text class="date-value">{{editStartDate}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
      <view class="form-group">
        <text class="form-label">结束日期</text>
        <picker mode="date" value="{{editEndDate}}" bindchange="onEditEndDateChange">
          <view class="date-picker">
            <text class="date-value">{{editEndDate || '未设置'}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
      <view class="form-group">
        <text class="form-label">备注</text>
        <input class="form-input" placeholder="添加备注..." value="{{editNotes}}" bindinput="onEditNotesInput" />
      </view>
    </view>
    <view class="modal-footer">
      <button class="btn btn-danger" bindtap="deletePeriodRecord">删除</button>
      <button class="btn btn-primary btn-pink" bindtap="submitPeriodEdit">保存</button>
    </view>
  </view>
</view>

<!-- ==================== 体检操作菜单 ==================== -->
<action-sheet
  show="{{showCheckupActionSheet}}" title="体检记录操作"
  bind:edit="onEditCheckupAction" bind:delete="onDeleteCheckupAction" bind:cancel="hideCheckupActionSheet"
/>

<!-- ==================== 陪玩编辑弹窗 ==================== -->
<view class="modal-overlay {{showPlayEditModal ? 'show' : ''}}" catchtap="hidePlayEditModal" wx:if="{{showPlayEditModal}}">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">编辑陪玩记录</text>
      <view class="modal-close" bindtap="hidePlayEditModal">×</view>
    </view>
    <view class="modal-body">
      <view class="form-group">
        <text class="form-label">陪玩者</text>
        <view class="play-edit-player">
          <text class="play-edit-player-emoji">{{editPlayerEmoji}}</text>
          <text class="play-edit-player-name">{{editPlayerName}}</text>
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">开始时间</text>
        <view class="datetime-row">
          <picker class="datetime-picker" mode="date" value="{{editPlayStartDate}}" bindchange="onPlayStartDateChange">
            <view class="date-picker">
              <text class="date-value">{{editPlayStartDate || '选择日期'}}</text>
              <text class="picker-arrow">›</text>
            </view>
          </picker>
          <picker class="datetime-picker" mode="time" value="{{editPlayStartTime}}" bindchange="onPlayStartTimeChange">
            <view class="date-picker">
              <text class="date-value">{{editPlayStartTime || '时间'}}</text>
              <text class="picker-arrow">›</text>
            </view>
          </picker>
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">结束时间</text>
        <view class="datetime-row">
          <picker class="datetime-picker" mode="date" value="{{editPlayEndDate}}" bindchange="onPlayEndDateChange">
            <view class="date-picker">
              <text class="date-value">{{editPlayEndDate || '选择日期'}}</text>
              <text class="picker-arrow">›</text>
            </view>
          </picker>
          <picker class="datetime-picker" mode="time" value="{{editPlayEndTime}}" bindchange="onPlayEndTimeChange">
            <view class="date-picker">
              <text class="date-value">{{editPlayEndTime || '时间'}}</text>
              <text class="picker-arrow">›</text>
            </view>
          </picker>
        </view>
        <text class="form-hint" wx:if="{{!editPlayEndDate && !editPlayEndTime}}">留空将保持"进行中"；补全日期和时间即可结束它</text>
      </view>
    </view>
    <view class="modal-footer">
      <button class="btn btn-danger" bindtap="onDeletePlayFromEdit">删除</button>
      <button class="btn btn-primary" bindtap="submitPlayEdit">保存</button>
    </view>
  </view>
</view>
