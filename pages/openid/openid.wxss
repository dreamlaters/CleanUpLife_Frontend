.container {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, #f8f2e9 0%, #f1e6d8 100%);
}

.notification-card {
  padding: 38rpx 28rpx 28rpx;
  border: 1rpx solid #e3d3c1;
  border-radius: 28rpx 28rpx 28rpx 8rpx;
  background: #fffdf8;
  box-shadow: 0 8rpx 24rpx rgba(91, 71, 55, 0.07);
}

.notification-header {
  padding-bottom: 30rpx;
  border-bottom: 1rpx dashed #dfcfbd;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.notification-icon-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 18rpx;
  border-radius: 28rpx 28rpx 28rpx 8rpx;
  background: #f2dfc1;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-2deg);
}

.page-kicker {
  color: #a66b56;
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.form-title {
  margin-top: 8rpx;
  color: #3f352f;
  font-size: 38rpx;
  font-weight: 750;
  line-height: 1.35;
}

.form-subtitle {
  max-width: 520rpx;
  margin-top: 10rpx;
  color: #7d6e62;
  font-size: 24rpx;
  line-height: 1.6;
}

.features-section {
  margin: 20rpx 0 26rpx;
}

.feature-item {
  min-height: 98rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx dashed #eadfd2;
}

.feature-item:last-child {
  border-bottom: 0;
}

.feature-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feature-icon-warning { background: #f3e5c9; }
.feature-icon-info { background: #e2ebef; }
.feature-icon-success { background: #e1eadc; }

.feature-content {
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
}

.feature-title {
  color: #3f352f;
  font-size: 27rpx;
  font-weight: 650;
}

.feature-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.feature-pending {
  padding: 2rpx 9rpx;
  border-radius: 8rpx;
  background: #f3e5c9;
  color: #8e642f;
  font-size: 17rpx;
  font-weight: 700;
}

.feature-desc {
  margin-top: 3rpx;
  color: #8a7b6f;
  font-size: 21rpx;
}

.subscribe-btn {
  min-height: 88rpx;
  border-radius: 18rpx 18rpx 18rpx 6rpx;
  background: #c96f55;
  color: #fff;
  box-shadow: 0 7rpx 18rpx rgba(201, 111, 85, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 29rpx;
  font-weight: 650;
}

.subscribe-btn::after {
  border: 0;
}

.subscribe-tip {
  margin-top: 14rpx;
  color: #9a8c7f;
  font-size: 21rpx;
  text-align: center;
}

.openid-section {
  margin-top: 30rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed #dfcfbd;
}

.openid-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #8a7b6f;
  font-size: 21rpx;
}

.openid-box {
  margin-top: 10rpx;
  padding: 15rpx 16rpx;
  border: 1rpx solid #e7dbcd;
  border-radius: 13rpx;
  background: #faf4eb;
}

.openid-loading,
.openid-text {
  color: #9a8c7f;
  font-size: 19rpx;
  line-height: 1.5;
  word-break: break-all;
}
