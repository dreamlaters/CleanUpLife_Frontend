.container {
  min-height: 100vh;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  color: #3f352f;
  background: #f8f2e9;
}

.page-intro {
  padding: 28rpx 32rpx 8rpx;
}

.page-kicker,
.section-kicker,
.modal-kicker {
  display: block;
  color: #9f4f3d;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.page-title {
  display: block;
  margin-top: 8rpx;
  color: #3f352f;
  font-family: serif;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.35;
}

.page-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #8d7c70;
  font-size: 23rpx;
}

.tab-content {
  padding-top: 8rpx;
}

.travel-heading,
.goals-toolbar {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 28rpx 18rpx;
}

.section-title {
  display: block;
  margin-top: 6rpx;
  color: #3f352f;
  font-family: serif;
  font-size: 31rpx;
  font-weight: 700;
}

.travel-count,
.year-picker {
  display: flex;
  align-items: center;
  gap: 7rpx;
  flex-shrink: 0;
  padding: 10rpx 14rpx;
  border: 1rpx solid #e6d8c8;
  border-radius: 18rpx;
  color: #75665c;
  background: #fffdf8;
  font-size: 21rpx;
}

.status-switch {
  display: flex;
  gap: 12rpx;
  padding: 0 28rpx 18rpx;
}

.status-option {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex: 1;
  min-height: 64rpx;
  border: 1rpx solid #e6d8c8;
  border-radius: 18rpx;
  color: #796b61;
  background: rgba(255, 253, 248, 0.64);
  font-size: 23rpx;
  font-weight: 600;
  transition: transform 0.18s ease;
}

.status-option:active,
.owner-option:active,
.wish-item:active {
  transform: scale(0.98);
}

.status-option-active {
  border-color: #c96f55;
  color: #9f4f3d;
  background: #fffdf8;
  box-shadow: 0 5rpx 16rpx rgba(115, 83, 62, 0.07);
}

.status-count {
  min-width: 27rpx;
  height: 27rpx;
  padding: 0 5rpx;
  border-radius: 14rpx;
  color: #fffdf8;
  background: #c96f55;
  font-size: 17rpx;
  line-height: 27rpx;
  text-align: center;
}

.paper-card {
  position: relative;
  margin: 0 24rpx;
  overflow: hidden;
  border: 1rpx solid #e6d8c8;
  border-radius: 24rpx;
  background: #fffdf8;
  box-shadow: 0 10rpx 30rpx rgba(95, 71, 53, 0.07);
}

.paper-rule {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 70rpx;
  width: 1rpx;
  background: rgba(201, 111, 85, 0.2);
}

.wish-list {
  padding: 12rpx 18rpx;
}

.wish-item {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 110rpx;
  padding: 13rpx 6rpx;
  border-bottom: 1rpx solid #eee2d5;
  transition: transform 0.18s ease;
}

.wish-item:last-child {
  border-bottom: 0;
}

.wish-index {
  z-index: 1;
  width: 48rpx;
  margin-right: 17rpx;
  color: #b89582;
  font-family: serif;
  font-size: 24rpx;
  font-style: italic;
  text-align: center;
}

.wish-content {
  flex: 1;
  min-width: 0;
}

.wish-title-row,
.wish-meta {
  display: flex;
  align-items: center;
}

.wish-title-row {
  gap: 12rpx;
}

.wish-name {
  overflow: hidden;
  flex: 1;
  color: #3f352f;
  font-size: 28rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.destination-type {
  flex-shrink: 0;
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
  font-size: 18rpx;
  font-weight: 600;
}

.type-domestic {
  color: #5f7958;
  background: #e7eee2;
}

.type-international {
  color: #9f4f3d;
  background: #f5e4dc;
}

.wish-meta {
  gap: 14rpx;
  margin-top: 10rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 5rpx;
  color: #7c6e63;
  font-size: 21rpx;
}

.longpress-hint {
  color: #b7a89d;
  font-size: 19rpx;
}

.mark-btn,
.visited-stamp {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  margin-left: 12rpx;
  border-radius: 50%;
}

.mark-btn {
  background: #dfe9da;
  box-shadow: inset 0 0 0 1rpx #c4d3bd;
}

.mark-btn:active {
  transform: scale(0.9);
}

.visited-stamp {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid #6f8a65;
  opacity: 0.78;
}

.owner-switch {
  display: flex;
  gap: 12rpx;
  margin: 0 24rpx 16rpx;
  padding: 6rpx;
  border: 1rpx solid #e6d8c8;
  border-radius: 22rpx;
  background: #eee3d5;
}

.owner-option {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
  padding: 14rpx 18rpx;
  border-radius: 17rpx;
  color: #827267;
  transition: transform 0.18s ease;
}

.owner-option-active {
  color: #3f352f;
  background: #fffdf8;
  box-shadow: 0 3rpx 10rpx rgba(86, 62, 47, 0.07);
}

.owner-pig-active {
  box-shadow: inset 0 -4rpx 0 #c96f55, 0 3rpx 10rpx rgba(86, 62, 47, 0.07);
}

.owner-donkey-active {
  box-shadow: inset 0 -4rpx 0 #6f8a65, 0 3rpx 10rpx rgba(86, 62, 47, 0.07);
}

.owner-emoji {
  font-size: 36rpx;
}

.owner-name,
.owner-count {
  display: block;
}

.owner-name {
  font-size: 23rpx;
  font-weight: 700;
}

.owner-count {
  margin-top: 2rpx;
  color: #9a8a7f;
  font-size: 18rpx;
}

.progress-summary {
  margin: 0 24rpx 16rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #e6d8c8;
  border-radius: 22rpx;
  background: #fffdf8;
}

.summary-copy,
.summary-owner {
  display: flex;
  align-items: center;
}

.summary-copy {
  justify-content: space-between;
  color: #594b43;
  font-size: 23rpx;
  font-weight: 600;
}

.summary-owner {
  gap: 8rpx;
}

.summary-emoji {
  font-size: 27rpx;
}

.summary-number {
  color: #9f4f3d;
  font-family: serif;
  font-size: 32rpx;
  font-weight: 700;
}

.summary-track,
.progress-bar {
  overflow: hidden;
  border-radius: 6rpx;
  background: #eee4d8;
}

.summary-track {
  height: 10rpx;
  margin-top: 12rpx;
}

.summary-fill,
.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: #6f8a65;
  transition: width 0.3s ease;
}

.summary-caption {
  display: block;
  margin-top: 9rpx;
  color: #95857a;
  font-size: 19rpx;
}

.goal-paper {
  padding: 8rpx 16rpx 18rpx 62rpx;
}

.notebook-margin {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 48rpx;
  width: 1rpx;
  background: rgba(201, 111, 85, 0.25);
}

.goal-list {
  position: relative;
  z-index: 1;
}

.goal-item-wrap {
  border-bottom: 1rpx solid #eee2d5;
}

.goal-item-wrap:last-child {
  border-bottom: 0;
}

.goal-item-completed {
  opacity: 0.68;
}

.goal-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 8rpx;
}

.goal-checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
  margin: 3rpx 14rpx 0 0;
  border: 2rpx solid #b7aa9f;
  border-radius: 50%;
}

.goal-checkbox-checked,
.sub-goal-checkbox-checked {
  border-color: #6f8a65;
  background: #dfe9da;
}

.goal-content {
  flex: 1;
  min-width: 0;
}

.goal-title {
  display: block;
  color: #3f352f;
  font-size: 27rpx;
  line-height: 1.5;
  word-break: break-all;
}

.goal-title-completed,
.sub-goal-title-completed {
  color: #94877e;
  text-decoration: line-through;
}

.goal-progress {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
}

.progress-bar {
  flex: 1;
  height: 7rpx;
}

.progress-text {
  min-width: 44rpx;
  color: #9b8c81;
  font-size: 18rpx;
  text-align: right;
}

.goal-expand-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  margin-left: 8rpx;
  transition: transform 0.2s ease;
}

.sub-goals {
  padding: 0 8rpx 16rpx 48rpx;
}

.sub-goal-item {
  display: flex;
  align-items: center;
  min-height: 56rpx;
  margin-bottom: 6rpx;
  padding: 6rpx 10rpx;
  border-left: 3rpx solid #ddcbbb;
  border-radius: 0 10rpx 10rpx 0;
  background: #fbf6ee;
}

.sub-goal-completed {
  border-left-color: #6f8a65;
}

.sub-goal-checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
  border: 2rpx solid #bbae9f;
  border-radius: 7rpx;
}

.sub-goal-title {
  flex: 1;
  color: #5b4f48;
  font-size: 22rpx;
  line-height: 1.45;
  word-break: break-all;
}

.add-sub-goal-btn,
.goal-add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  color: #9f4f3d;
  font-size: 22rpx;
  font-weight: 600;
}

.add-sub-goal-btn {
  min-height: 52rpx;
  border: 1rpx dashed #d9c5b3;
  border-radius: 12rpx;
}

.goal-add-btn {
  min-height: 72rpx;
  margin-top: 12rpx;
  border: 1rpx dashed #cfb8a4;
  border-radius: 16rpx;
  background: #fbf4e9;
}

.add-sub-goal-btn:active,
.goal-add-btn:active {
  background: #f3e7da;
}

.goal-empty {
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 8rpx;
  padding: 52rpx 20rpx 38rpx;
  color: #9a897e;
  font-size: 21rpx;
}

.goal-empty-title {
  color: #594b43;
  font-size: 27rpx;
  font-weight: 650;
}

.fab-btn {
  position: fixed;
  right: 28rpx;
  bottom: calc(130rpx + env(safe-area-inset-bottom));
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border: 4rpx solid #f8f2e9;
  border-radius: 50%;
  background: #c96f55;
  box-shadow: 0 10rpx 25rpx rgba(125, 70, 52, 0.28);
}

.fab-btn:active {
  transform: scale(0.93);
}

.savings-tab-content {
  padding-bottom: 0;
}

.modal-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
  display: flex;
  align-items: flex-end;
  background: rgba(63, 53, 47, 0.46);
}

.modal-content {
  width: 100%;
  max-height: 86vh;
  overflow: hidden;
  border-radius: 30rpx 30rpx 0 0;
  background: #fffdf8;
  animation: slide-up 0.28s ease-out;
}

.modal-content-small {
  max-height: 54vh;
}

@keyframes slide-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.modal-handle {
  width: 72rpx;
  height: 7rpx;
  margin: 14rpx auto 2rpx;
  border-radius: 4rpx;
  background: #ddcfc0;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 30rpx;
  border-bottom: 1rpx solid #eadfd2;
}

.modal-title {
  display: block;
  margin-top: 5rpx;
  color: #3f352f;
  font-family: serif;
  font-size: 31rpx;
  font-weight: 700;
}

.modal-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  color: #88776b;
  background: #f3e9dd;
  font-size: 34rpx;
}

.modal-body {
  max-height: 58vh;
  padding: 26rpx 30rpx 8rpx;
  overflow-y: auto;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  margin-bottom: 10rpx;
  color: #665950;
  font-size: 23rpx;
  font-weight: 600;
}

.form-input,
.form-picker {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #e6d8c8;
  border-radius: 16rpx;
  color: #3f352f;
  background: #fbf6ee;
  font-size: 27rpx;
}

.form-input {
  height: 82rpx;
  padding: 0 20rpx;
}

.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 82rpx;
  padding: 0 20rpx;
  color: #a08f83;
}

.form-picker-selected {
  color: #3f352f;
}

.form-input-placeholder {
  color: #ad9d91;
}

.slider-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.slider-value {
  color: #9f4f3d;
  font-size: 21rpx;
  font-weight: 600;
}

.modal-footer {
  display: flex;
  gap: 14rpx;
  padding: 18rpx 30rpx calc(26rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eadfd2;
}

.btn {
  flex: 1;
  height: 78rpx;
  margin: 0;
  border-radius: 16rpx;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 78rpx;
}

.btn::after {
  border: 0;
}

.btn-secondary {
  color: #6f6157;
  background: #eee4d8;
}

.btn-primary {
  color: #fffdf8;
  background: #c96f55;
  box-shadow: 0 6rpx 15rpx rgba(159, 79, 61, 0.2);
}

.safe-bottom {
  height: env(safe-area-inset-bottom);
}
