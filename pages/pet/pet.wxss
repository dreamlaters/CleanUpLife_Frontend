/**
 * 宠物页面样式 - 统一设计语言 v3.0
 * CleanUpLife - 清新简约风格
 */

.container {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

/* ==================== 宠物卡片 ==================== */
.pet-cards {
  display: flex;
  gap: 12rpx;
  padding: 20rpx 24rpx;
}

.pet-card {
  flex: 1;
  background: #ffffff;
  border-radius: 22rpx;
  padding: 20rpx 14rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pet-card-accent {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: var(--accent-color);
}

.pet-avatar {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.pet-emoji {
  font-size: 40rpx;
}

.pet-info {
  text-align: center;
}

.pet-name {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 6rpx;
}

.pet-weight-wrap {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 2rpx;
}

.pet-weight {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
}

.pet-unit {
  font-size: 20rpx;
  color: #9ca3af;
}

/* ==================== 区块卡片 ==================== */
.section-card {
  margin: 0 24rpx 16rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.section-icon {
  font-size: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.section-badge {
  font-size: 22rpx;
  color: #9ca3af;
  background: #f9fafb;
  padding: 6rpx 14rpx;
  border-radius: 14rpx;
}

/* ==================== 筛选标签 ==================== */
.filter-tabs {
  display: flex;
  gap: 8rpx;
  padding: 0 20rpx 16rpx;
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 22rpx;
  font-weight: 500;
  color: #6b7280;
  background: #f9fafb;
  border-radius: 12rpx;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  border: 1rpx solid #f3f4f6;
}

.filter-tab:active {
  transform: scale(0.96);
}

.filter-tab-active {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.3);
}

/* ==================== 图表区域 ==================== */
.chart-wrapper {
  padding: 0 18rpx 14rpx;
}

.chart-container {
  width: 100%;
  height: 340rpx;
  background: #f9fafb;
  border-radius: 18rpx;
  overflow: hidden;
}

.weight-canvas {
  width: 100%;
  height: 100%;
}

.chart-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.placeholder-icon {
  font-size: 44rpx;
}

.placeholder-text {
  font-size: 24rpx;
  color: #9ca3af;
}

/* ==================== 图例 ==================== */
.chart-legend {
  display: flex;
  justify-content: center;
  gap: 28rpx;
  padding: 6rpx 20rpx 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.legend-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

.legend-text {
  font-size: 22rpx;
  color: #6b7280;
}

/* ==================== 记录列表 ==================== */
.records-container {
  padding: 14rpx 18rpx 18rpx;
}

.person-group {
  margin-bottom: 20rpx;
}

.person-group:last-child {
  margin-bottom: 0;
}

.person-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6rpx;
  margin-bottom: 10rpx;
}

.person-info {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.person-emoji {
  font-size: 24rpx;
}

.person-name {
  font-size: 24rpx;
  font-weight: 600;
}

.person-badge {
  font-size: 18rpx;
  color: #9ca3af;
  background: #f9fafb;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

/* ==================== 记录网格 ==================== */
.record-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
}

.record-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 8rpx;
  background: #f9fafb;
  border-radius: 14rpx;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  border: 1rpx solid transparent;
}

.record-card:active {
  transform: scale(0.96);
  background: #f3f4f6;
  border-color: #e5e7eb;
}

.record-date {
  font-size: 18rpx;
  color: #9ca3af;
  margin-bottom: 4rpx;
}

.record-value {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.record-weight {
  font-size: 28rpx;
  font-weight: 700;
}

.record-unit {
  font-size: 16rpx;
  color: #9ca3af;
}

/* ==================== 弹窗样式 ==================== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
  display: flex;
  align-items: flex-end;
  opacity: 1;
  visibility: visible;
}

.modal-overlay.show {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  width: 100%;
  max-height: 85vh;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  transform: translateY(0);
  overflow: hidden;
  animation: slideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.modal-overlay.show .modal-content {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #9ca3af;
  border-radius: 50%;
  background: #f9fafb;
}

.modal-body {
  padding: 32rpx;
  max-height: 60vh;
  overflow-y: auto;
  overflow-x: visible;
}

.modal-footer {
  padding: 16rpx 32rpx 24rpx;
  display: flex;
  gap: 12rpx;
}

/* ==================== 表单元素 ==================== */
.form-group {
  margin-bottom: 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #6b7280;
  margin-bottom: 10rpx;
  display: block;
}

/* ==================== 宠物选择器 ==================== */
.person-selector {
  display: flex;
  gap: 12rpx;
}

.person-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 18rpx 14rpx;
  background: #f9fafb;
  border-radius: 16rpx;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  border: 2rpx solid transparent;
}

.person-option-active {
  background: rgba(99, 102, 241, 0.08);
  border-color: #6366f1;
}

.option-emoji {
  font-size: 32rpx;
}

.option-name {
  font-size: 22rpx;
  color: #6b7280;
  font-weight: 500;
}

.person-option-active .option-name {
  color: #6366f1;
}

/* ==================== 输入框 ==================== */
.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
}

.weight-input {
  flex: 1;
  min-width: 0;
  width: 100%;
  height: auto !important;
  min-height: 80rpx !important;
  line-height: 80rpx !important;
  padding: 0 80rpx 0 24rpx !important;
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  font-size: 32rpx;
  color: #111827;
  box-sizing: border-box;
  transition: all 0.15s;
  overflow: visible !important;
  text-overflow: ellipsis !important;
}

.weight-input:focus {
  background: #ffffff;
  border-color: #6366f1;
}

.input-suffix {
  position: absolute;
  right: 24rpx;
  color: #9ca3af;
  font-size: 28rpx;
  pointer-events: none;
}

/* ==================== 日期选择器 ==================== */
.date-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 18rpx 20rpx;
  background: #f9fafb;
  border: 2rpx solid transparent;
  border-radius: 14rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  transition: all 0.15s;
  color: #111827;
}

.date-value {
  flex: 1;
}

.picker-arrow {
  font-size: 18rpx;
  color: #9ca3af;
}

/* ==================== 按钮 ==================== */
.btn {
  flex: 1;
  padding: 18rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  transition: all 0.15s;
}

.btn:active {
  transform: scale(0.98);
}

.btn-cancel {
  background: #f3f4f6;
  color: #6b7280;
}

.btn-primary {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(99, 102, 241, 0.35);
}

.record-weight {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.record-unit {
  font-size: 18rpx;
  color: #9ca3af;
}

.record-date {
  font-size: 20rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

/* ==================== 弹窗表单（已在上方定义，此处移除重复） ==================== */

.modal-header {
  padding: 28rpx 32rpx;
  text-align: center;
  border-bottom: 1rpx solid #f5f5f5;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.modal-body {
  padding: 32rpx;
  max-height: 50vh;
  overflow-y: auto;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #6b7280;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  width: 100%;
  padding: 20rpx 24rpx;
  background: #fafafa;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #1a1a2e;
  box-sizing: border-box;
}

.form-input-placeholder {
  color: #9ca3af;
}

/* ==================== 宠物选择器 ==================== */
.pet-selector {
  display: flex;
  gap: 16rpx;
}

.pet-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 16rpx;
  background: #fafafa;
  border-radius: 18rpx;
  transition: all 0.2s ease;
  border: 2rpx solid transparent;
}

.pet-option-active {
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.08) 0%, rgba(139, 92, 246, 0.08) 100%);
  border-color: #6366f1;
}

.pet-option-emoji {
  font-size: 36rpx;
}

.pet-option-name {
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 500;
}

.pet-option-active .pet-option-name {
  color: #6366f1;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #f5f5f5;
}

.modal-btn {
  flex: 1;
  padding: 22rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  transition: all 0.2s ease;
}

.modal-btn:active {
  transform: scale(0.98);
}

.modal-btn-cancel {
  background: #f5f5f5;
  color: #6b7280;
}

.modal-btn-confirm {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(99, 102, 241, 0.35);
}

/* ==================== Warm journal legacy alignment ==================== */
.container {
  background: #f8f2e9;
  color: #3f352f;
}

.pet-cards {
  gap: 16rpx;
  padding: 18rpx 24rpx 20rpx;
}

.pet-card,
.section-card {
  background: #fffdf8;
  border: 1rpx solid #e6d8c8;
  box-shadow: 0 6rpx 18rpx rgba(91, 71, 55, 0.06);
}

.pet-card {
  min-height: 164rpx;
  padding: 24rpx 16rpx 20rpx;
  border-radius: 20rpx;
}

.pet-card-accent {
  height: 4rpx;
}

.pet-avatar {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 10rpx;
  background: #f3e9dc;
}

.pet-name,
.pet-weight,
.section-title,
.modal-title {
  color: #3f352f;
}

.pet-name {
  font-size: 25rpx;
}

.pet-weight {
  font-size: 38rpx;
}

.pet-unit,
.section-badge,
.legend-text,
.record-date,
.record-unit,
.person-badge,
.placeholder-text,
.input-suffix,
.picker-arrow {
  color: #8c7b6d;
}

.section-card {
  margin-bottom: 20rpx;
  border-radius: 20rpx;
}

.section-header {
  min-height: 84rpx;
  padding: 0 24rpx;
  border-bottom-color: #efe4d7;
}

.section-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #f3e9dc;
}

.section-title {
  font-size: 29rpx;
}

.section-badge,
.person-badge {
  background: #f3e9dc;
}

.filter-tabs {
  gap: 10rpx;
  padding: 18rpx 20rpx 16rpx;
}

.filter-tab {
  min-height: 60rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6a5c50;
  background: #faf3e9;
  border-color: #e6d8c8;
  border-radius: 14rpx;
}

.filter-tab-active {
  color: #fffdf8;
  background: #9f4f3d;
  border-color: #9f4f3d;
  box-shadow: none;
}

.chart-wrapper {
  padding: 0 20rpx 12rpx;
}

.chart-container {
  height: 330rpx;
  background: #fffaf2;
  border: 1rpx solid #efe4d7;
  border-radius: 16rpx;
}

.placeholder-icon,
.empty-icon {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f3e9dc;
}

.records-container {
  padding: 20rpx;
}

.person-header {
  min-height: 56rpx;
  margin-bottom: 10rpx;
}

.record-grid {
  gap: 10rpx;
}

.record-card {
  min-height: 90rpx;
  justify-content: center;
  padding: 14rpx 8rpx;
  background: #faf3e9;
  border-color: #efe4d7;
}

.record-card:active {
  background: #f3e9dc;
  border-color: #e6d8c8;
}

.empty-state {
  padding: 48rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-title {
  margin-top: 18rpx;
  font-size: 29rpx;
  font-weight: 650;
  color: #3f352f;
}

.empty-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8c7b6d;
  text-align: center;
}

.empty-action {
  min-width: 220rpx;
  min-height: 80rpx;
  margin-top: 24rpx;
  color: #9f4f3d;
  background: #f6e4dc;
  border: 1rpx solid #dfb9aa;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 80rpx;
}

.empty-action::after {
  border: 0;
}

.fab-btn {
  width: 96rpx;
  height: 96rpx;
  background: #e8c0b3;
  border: 1rpx solid #d69a87;
  box-shadow: 0 10rpx 24rpx rgba(159, 79, 61, 0.2);
}

.modal-overlay {
  background: rgba(63, 53, 47, 0.46);
}

.modal-content {
  background: #fffdf8;
  border-radius: 26rpx 26rpx 0 0;
}

.modal-header {
  min-height: 88rpx;
  padding: 0 32rpx;
  border-bottom-color: #e6d8c8;
}

.modal-title,
.form-label-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.modal-close {
  width: 64rpx;
  height: 64rpx;
  color: #6a5c50;
  background: #f3e9dc;
}

.form-label {
  color: #6a5c50;
}

.weight-input,
.date-picker {
  min-height: 84rpx;
  color: #3f352f;
  background: #faf3e9;
  border: 1rpx solid #e6d8c8;
  border-radius: 14rpx;
}

.weight-input:focus {
  background: #fffdf8;
  border-color: #c96f55;
}

.person-option {
  min-height: 92rpx;
  background: #faf3e9;
  border: 1rpx solid #e6d8c8;
}

.person-option-active {
  background: #f6e4dc;
  border-color: #c98d7a;
}

.option-name,
.person-option-active .option-name {
  color: #3f352f;
}

.btn {
  min-height: 84rpx;
  padding: 0 20rpx;
  border: 0;
  border-radius: 14rpx;
}

.btn-secondary {
  color: #6a5c50;
  background: #f3e9dc;
}

.btn-primary {
  color: #fffdf8;
  background: #9f4f3d;
  box-shadow: none;
}
