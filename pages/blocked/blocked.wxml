<view class="container">
  <view class="blocked-note">
    <view class="note-tape"></view>
    <view class="blocked-icon-wrap"><app-icon name="lock" size="56" /></view>
    <text class="blocked-kicker">PRIVATE JOURNAL</text>
    <text class="blocked-title">这本生活手账暂未向你开放</text>
    <text class="blocked-subtitle">{{message}}</text>
    <view class="hint-section">
      <text class="hint-title">如何获得访问权限</text>
      <text class="hint-text">请联系管理员，将你的微信账号加入家庭白名单。</text>
    </view>
  </view>
</view>
