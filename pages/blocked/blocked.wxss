.container {
  min-height: 100vh;
  padding: 240rpx 24rpx 40rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f8f2e9 0%, #f1e6d8 100%);
}

.blocked-note {
  position: relative;
  padding: 54rpx 34rpx 34rpx;
  border: 1rpx solid #decbb4;
  border-radius: 26rpx 26rpx 26rpx 8rpx;
  background: #fffaf2;
  box-shadow: 0 10rpx 30rpx rgba(91, 71, 55, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  transform: rotate(-0.5deg);
}

.note-tape {
  position: absolute;
  top: -18rpx;
  width: 112rpx;
  height: 34rpx;
  background: rgba(220, 180, 109, 0.42);
  transform: rotate(2deg);
}

.blocked-icon-wrap {
  width: 106rpx;
  height: 106rpx;
  margin-bottom: 20rpx;
  border-radius: 32rpx 32rpx 32rpx 10rpx;
  background: #f0dfca;
  display: flex;
  align-items: center;
  justify-content: center;
}

.blocked-kicker {
  color: #a66b56;
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.blocked-title {
  max-width: 520rpx;
  margin-top: 10rpx;
  color: #3f352f;
  font-size: 38rpx;
  font-weight: 750;
  line-height: 1.45;
}

.blocked-subtitle {
  margin-top: 14rpx;
  color: #7d6e62;
  font-size: 25rpx;
  line-height: 1.65;
}

.hint-section {
  width: 100%;
  margin-top: 34rpx;
  padding: 22rpx;
  box-sizing: border-box;
  border: 1rpx dashed #d8c3aa;
  border-radius: 16rpx;
  background: #f5eadc;
  display: flex;
  flex-direction: column;
  text-align: left;
}

.hint-title {
  color: #6a5c50;
  font-size: 23rpx;
  font-weight: 700;
}

.hint-text {
  margin-top: 5rpx;
  color: #8a7b6f;
  font-size: 22rpx;
  line-height: 1.6;
}
